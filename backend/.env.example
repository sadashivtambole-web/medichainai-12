# ─────────────────────────────────────────────────────────────
# FAKE DRUG DETECTION — BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas or Local Compass)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.cxtebif.mongodb.net/medichain_ai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.cxtebif.mongodb.net/medichain_ai?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_hex_string_minimum_32_characters

# Gemini AI (for AI medicine verification and ID OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Creator / Super Admin Credentials
# This account is auto-created/synced on server startup.
CREATOR_NAME="System Creator"
CREATOR_EMAIL=creator@drugchain.network
CREATOR_PASSWORD=CHANGE_ME_strong_password_here

# ── SMTP Email Configuration ─────────────────────────────────────────────
# Required for sending real 6-digit verification codes for registration and login.
#
# Standard SMTP configuration:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MAIL_FROM="MediChainAI Security" <adminmedchainai@gmail.com>

# Alternative service shortcut (optional):
# SMTP_SERVICE=gmail
# SMTP_FROM="MediChainAI" <noreply@medichain.ai>

# ── Email Branding (optional — defaults shown) ────────────────────────────
# APP_NAME=MediChainAI
# APP_TAGLINE=Secure Pharmaceutical Supply Chain
# SUPPORT_EMAIL=support@medichain.ai
# BRAND_COLOR=#4F46E5

# Logging level: error | warn | info | debug (default: info)
# LOG_LEVEL=info
